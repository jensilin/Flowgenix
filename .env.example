# Optional settings. Flowgenix is offline and does not talk to NiFi.
FLOWGENIX_HOST=127.0.0.1
FLOWGENIX_PORT=7860
# FLOWGENIX_RELOAD=1

# Keep a server-side copy of every migration. Downloads work without it — the
# browser saves the files it is handed. Leave unset on Vercel (read-only disk).
# FLOWGENIX_ARCHIVE_DIR=./migrations
